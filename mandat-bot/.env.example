# Bu faylning nusxasini `.env` nomi bilan saqlang va qiymatlarni to'ldiring.
# `.env` git'ga tushmaydi (.gitignore'da).

# @BotFather dan olingan token
TELEGRAM_BOT_TOKEN=

# Xabar keladigan chat. Bilmasangiz: python mandat-bot/chat_id.py
TELEGRAM_CHAT_ID=

# Shaxsiy kabinetni tekshirish uchun (ixtiyoriy).
# Chrome -> my.uzbmb.uz ga kiring -> F12 -> Application -> Cookies -> PHPSESSID
UZBMB_PHPSESSID=

# Kuniga bir marta "hali chiqmadi" xabari kelsinmi (1 = ha, 0 = yo'q)
SEND_HEARTBEAT=1

# Kunlik xabar soati (Toshkent vaqti)
HEARTBEAT_HOUR=8
